#
# quickscript Standard Library
# Version 0
#

/**
 * Not-A-Number
 */
export native const float64 NaN

/**
 * Square root of one divided by two
 */
export native const float64 SQRT1_2

/**
 * Square root of two
 */
export native const float64 SQRT2

/**
 * Positive infinity
 */
export native const float64 POSITIVE_INFINITY

/**
 * Negative infinity
 */
export native const float64 NEGATIVE_INFINITY

/**
 * Ratio of the circumference of a circle to its diameter
 */
export native const float64 PI

/**
 * Euler's number
 * Base of the natural logarithm
 */
export native const float64 E

/**
 * Ratio of the circumference of a circle to its radius
 */
export native const float64 TAU

/**
 * Natural logarithm of 10
 */
export native const float64 LN10

/**
 * Natural logarithm of 2
 */
export native const float64 LN2

/**
 * Base-10 logarithm of E
 */
export native const float64 LOG10E

/**
 * Base-2 logarithm of E
 */
export native const float64 LOG2E

/**
 * Print a formatted message to the standard output
 * 
 * FORMAT CODES:
 * - '%d' Decimal number
 * - '%x' Hexadecimal number
 * - '%X' Uppercase hexadecimal number
 * - '%o' Base 8 (octal) number
 * - '%O' Upper case base 8 (octal) number
 * - '%b' Binary base 2 number
 * - '%s' Convert the argument to string
 * - '%c' Convert the argument to a UTF-32 unicode character
 * - '%e' Convert the argument to scientific notation
 * - '%t' Treat the argument as a UNIX timestamp and print the date time
 * 
 * FLAGS:
 * - <number>  Pad the string with spaces to the left or right
 *             (depending on if the number is negative or not)
 *             Example: '%3s'
 * - 0<number> Pad the string with '0' characters to the left or right
 *             (depending on if the number is negative or not)
 *             Example: '%03s'
 * - .<number> Number precision flag
 *             Example: '%.2d'
 * - $<number> Argument index
 *             Example: '%$2s'
 * 
 * EXAMPLES:
 * - printf("Hello world!\n") Prints hello world with a newline character at the end
 * - printf("number: %d", 23) Prints the number
 * 
 */
export native void printf(string format, ... args)

/**
 * Print a message to the standard output
 */
export native void println(string message)

/**
 * Format a string
 * 
 * FORMAT CODES:
 * - '%d' Decimal number
 * - '%x' Hexadecimal number
 * - '%X' Uppercase hexadecimal number
 * - '%o' Base 8 (octal) number
 * - '%O' Upper case base 8 (octal) number
 * - '%b' Binary base 2 number
 * - '%s' Convert the argument to string
 * - '%c' Convert the argument to a UTF-32 unicode character
 * - '%e' Convert the argument to scientific notation
 * - '%t' Treat the argument as a UNIX timestamp and print the date time
 * 
 * FLAGS:
 * - <number>  Pad the string with spaces to the left or right
 *             (depending on if the number is negative or not)
 *             Example: '%3s'
 * - 0<number> Pad the string with '0' characters to the left or right
 *             (depending on if the number is negative or not)
 *             Example: '%03s'
 * - .<number> Number precision flag
 *             Example: '%.2d'
 * - $<number> Argument index
 *             Example: '%$2s'
 * 
 * EXAMPLES:
 * - printf("Hello world!\n") Prints hello world with a newline character at the end
 * - printf("number: %d", 23) Prints the number
 * 
 */
export native string sformat(string format, ... args)

/**
 * Get the current time as a UNIX timestamp
 */
export native uint64 currentTimeMillis()

/**
 * Get the absolute value of a number
 * 
 * If the argument is non-negative, the argument is returned
 * Otherwise the argument is negated and returned.
 */
export native int8 abs(int8 x)

/**
