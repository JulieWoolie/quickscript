#
# quickscript Standard Library
# Version 0
#

native module std from "stdlib"

/**
 * Not-A-Number
 */
export const float64 NaN = -(0.0 / 0.0)

/**
 * Positive infinity
 */
export const float64 POSITIVE_INFINITY = 1.0 / 0.0

/**
 * Negative infinity
 */
export const float64 NEGATIVE_INFINITY = -(1.0 / 0.0)

/**
 * Ratio of the circumference of a circle to its diameter
 */
export const float64 PI = 3.141592653589793

/**
 * Euler's number
 * Base of the natural logarithm
 */
export const float64 E = 2.718281828459045

/**
 * Ratio of the circumference of a circle to its radius
 */
export const float64 TAU = 6.283185307179586

/**
 * Natural logarithm of 10
 */
export const float64 LN10 = 2.302585092994046

/**
 * Natural logarithm of 2
 */
export const float64 LN2 = 0.6931471805599453

/**
 * Base-10 logarithm of E
 */
export const float64 LOG10E = 0.4342944819032518

/**
 * Base-2 logarithm of E
 */
export const float64 LOG2E = 1.4426950408889634

/**
 * Square root of one divided by two
 */
export const float64 SQRT1_2 = 0.7071067811865476

/**
 * Square root of two
 */
export const float64 SQRT2 = 1.4142135623730951

/**
 * Print a message to the standard output
 */
export native void println(string message)

/**
 * Get the current time as a UNIX timestamp
 */
export native uint64 currentTimeMillis()

/**
 * Get the value of an environment variable
 * 
 * If the variable was not found, an empty string is returned
 */
export native string getenv(string name)

/**
 * Set the value of an environment variable
 * 
 * If the variable is already defined this function will return false
 * 
 * The environment variable will only be changed for the current process and any processes
 * spawned by the current process
 */
export native bool setenv(string name, string value)

/**
 * Set the value of an environment variable
 * 
 * If the variable is defined and overwrite is set to true, then the value will be overridden
 * and this function will return true, otherwise, if overwrite is set to false, then this will
 * return false
 * 
 * The environment variable will only be changed for the current process and any processes
 * spawned by the current process
 */
export native bool setenv(string name, string value, bool overwrite)

/**
 * Get the absolute value of a number
 * 
 * If the argument is non-negative, the argument is returned
 * Otherwise the argument is negated and returned.
 */
export const int8 abs(int8 x) {
  return x < 0 ? -x : x
}

/**
 * Get the absolute value of a number
 * 
 * If the argument is non-negative, the argument is returned
 * Otherwise the argument is negated and returned.
 */
export const int16 abs(int16 x) {
  return x < 0 ? -x : x
}

/**
 * Get the absolute value of a number
 * 
 * If the argument is non-negative, the argument is returned
 * Otherwise the argument is negated and returned.
 */
export const int32 abs(int32 x) {
