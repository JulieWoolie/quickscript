/**
 * Get the absolute value of a number
 * 
 * If the argument is non-negative, the argument is returned
 * Otherwise the argument is negated and returned.
 */
export const float64 abs(float64 x) {
  return x < 0 ? -x : x
}

/**
 * Get the smallest value
 */
export int8 min(int8... values) {
  if values.length == 0 return 0
  
  int8 r = values[0]
  int8 v = 0
  const uint32 len = values.length
  
  for (uint32 i = 1; i < len; ++i) {
    r = (v = values[i]) < r ? v : r
  }
  
  return r
}

/**
 * Get the smallest value
 */
export uint8 min(uint8... values) {
  if values.length == 0 return 0
  
  uint8 r = values[0]
  uint8 v = 0
  const uint32 len = values.length
  
  for (uint32 i = 1; i < len; ++i) {
    r = (v = values[i]) < r ? v : r
  }
  
  return r
}

