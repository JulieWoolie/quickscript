/**
 * Get the largest value
 */
export int8 max(int8... values) {
  if values.length == 0 return 0
  
  int8 r = values[0]
  int8 v = 0
  const uint32 len = values.length
  
  for (uint32 i = 1; i < len; ++i) {
    r = (v = values[i]) > r ? v : r
  }
  
  return r
}

