
uint32 mul(uint32... values) {
  uint32 result = 0
  for (uint32 i = 0; i < values.length; i++) {
    result *= values[i]
  }
  return result
}

void main() {
  uint32 r1 = mul()
  uint32 r2 = mul(2, 3)
  uint32 r3 = mul(3, 3, 3)

  assert r1 == 0 : "r1 == 0, r1: " + r1
  assert r2 == 6 : "r2 == 6, r2: " + r2
  assert r3 == 27 : "r3 == 27, r3: " + r3
}