# MODE validate

# This should fail
const int32 GLOBAL = f()

# This shouldn't
const int32 GLOBAL2 = y()

# This should still fail despite GLOBAL3 not being accessed,
# but because GLOBAL4 is being accessed.
const int32 GLOBAL3 = z()
const int32 GLOBAL4 = 0

# ERROR message="Accessing 'GLOBAL' before its initialized"
int32 f() {
  return GLOBAL
}

int32 y() {
  return 0
}

# ERROR message="Accessing 'GLOBAL4' before its initialized"
int32 z() {
  return GLOBAL4
}

void main() {
  # ERROR message="Accessing 'z' before its initialized"
  uint32 z = z
}